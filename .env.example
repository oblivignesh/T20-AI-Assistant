# Which chat LLM to use for the chatbot/quiz features: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# Google Gemini (used as the chat LLM when LLM_PROVIDER=gemini, and ALWAYS used for
# embeddings/semantic search, even when LLM_PROVIDER=anthropic - see README).
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Anthropic Claude (used as the chat LLM when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Paths (defaults shown, usually no need to change)
PDF_PATH=knowledgebase/T20_rules.pdf
VECTORSTORE_PATH=vectorstore/t20_rules_index.json
